      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam roundcorner 5\nskinparam shadowing false\n\npackage \&quot;Mecánicas de Juego (Game Loop)\&quot; {\n    \n    class Partida {\n        - jugador1: Jugador\n        - jugador2: Jugador\n        - turnoActual: int\n        + iniciarPartida()\n        + ejecutarTurno(jugadorActivo: Jugador)\n        + mostrarInterfazConsola()\n        + verificarVictoria(): boolean\n    }\n\n    class Jugador {\n        - nombre: String\n        - mazo: Mazo\n        - mano: Mano\n        - banco: List&lt;PokemonCard&gt;\n        - pokemonActivo: PokemonCard\n        - puntosPremio: int\n        - energiaDisponible: int\n        + robarCarta()\n        + colocarEnBanco(carta: PokemonCard)\n        + adjuntarEnergia(pokemon: PokemonCard)\n        + retirarActivo()\n        + atacarRival(rival: Jugador)\n    }\n\n    class Mazo {\n        - cartas: List&lt;AbstractCard&gt;\n        + inicializarMazo(cartas: List&lt;AbstractCard&gt;)\n        + barajar()\n        + robar(): AbstractCard\n        + validarMazo(): boolean\n        + hacerMulligan()\n    }\n\n    class Mano {\n        - cartas: List&lt;AbstractCard&gt;\n        + agregarCarta(carta: AbstractCard)\n        + descartarCarta(carta: AbstractCard)\n        + vaciarMano()\n    }\n}\n\npackage \&quot;Sistema de Cartas (Entidades)\&quot; {\n\n    interface Activable &lt;&lt;interface&gt;&gt; {\n        + activarEfecto(partida: Partida, jugador: Jugador)\n    }\n\n    abstract class AbstractCard {\n        - nombre: String\n        - numeroCarta: int\n        + getNombre(): String\n    }\n\n    class PokemonCard {\n        - puntosSalud: int\n        - tipo: Type\n        - costoRetirada: int\n        - ataques: List&lt;Attack&gt;\n        - esEx: boolean\n        - energiasAdjuntas: int\n        + recibirDano(cantidad: int, tipoAtacante: Type)\n        + estaDerrotado(): boolean\n        + calcularPuntosPremio(): int\n    }\n\n    class TrainerCard {\n        - tipoEntrenador: String\n        + activarEfecto(partida: Partida, jugador: Jugador)\n    }\n    \n    class Attack {\n        - nombre: String\n        - danoBase: int\n        - costoEnergia: int\n    }\n}\n\n&#39; Relaciones Core del Juego\nPartida *-- \&quot;2\&quot; Jugador : controla &gt;\nJugador *-- \&quot;1\&quot; Mazo : tiene &gt;\nJugador *-- \&quot;1\&quot; Mano : tiene &gt;\nJugador o-- \&quot;0..2\&quot; PokemonCard : banco\nJugador o-- \&quot;1\&quot; PokemonCard : activo\n\nMazo o-- \&quot;0..20\&quot; AbstractCard : contiene &gt;\nMano o-- \&quot;0..*\&quot; AbstractCard : contiene &gt;\n\n&#39; Herencia y Relaciones de Cartas\nAbstractCard &lt;|-- PokemonCard\nAbstractCard &lt;|-- TrainerCard\nPokemonCard *-- \&quot;1..2\&quot; Attack : posee &gt;\n\n&#39; Interfaces\nActivable &lt;|.. TrainerCard\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fOZNezJALAzpYPIeDA3Q-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
